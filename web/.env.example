# Vercel environment variable (not needed locally).
# Leave unset for local development: the mock data in public/data is used
# (a build with this set leaves public/data out of dist/; map borders are in public/boundaries).
# In Vercel: Project → Settings → Environment Variables.
# Production (Vercel): /r2/v1/  → web/vercel.json forwards /r2/* to the R2 bucket,
# so browsers only talk to vercel.app (*.r2.dev is blocked on some networks).
VITE_DATA_URL=/r2/v1/
# Optional, only if tiles are hosted somewhere else:
# VITE_TILES_URL=
