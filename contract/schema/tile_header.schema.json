{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "tile_header.schema.json",
  "title": "tiles/{VAR}/{ty}_{tx}.bin header",
  "type": "object",
  "required": [
    "schema_version",
    "kind",
    "var",
    "tx",
    "ty",
    "i0",
    "j0",
    "nlat",
    "nlon",
    "start",
    "months",
    "packing"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "pattern": "^1\\.\\d+$"
    },
    "kind": {
      "const": "tile"
    },
    "var": {
      "enum": [
        "T2M",
        "QV2M",
        "SPEED",
        "PRECTOT",
        "EVAP",
        "GWETROOT",
        "RUNOFF",
        "SNOMAS",
        "TOTEXTTAU"
      ]
    },
    "tx": {
      "type": "integer",
      "minimum": 0,
      "maximum": 35
    },
    "ty": {
      "type": "integer",
      "minimum": 0,
      "maximum": 17
    },
    "i0": {
      "type": "integer",
      "minimum": 0
    },
    "j0": {
      "type": "integer",
      "minimum": 0
    },
    "nlat": {
      "enum": [
        20,
        21
      ]
    },
    "nlon": {
      "const": 16
    },
    "start": {
      "type": "string",
      "pattern": "^\\d{4}-(0[1-9]|1[0-2])$"
    },
    "months": {
      "type": "integer",
      "minimum": 1
    },
    "packing": {
      "type": "object",
      "required": [
        "scale",
        "offset"
      ],
      "properties": {
        "scale": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "offset": {
          "type": "number"
        }
      },
      "additionalProperties": false
    }
  }
}