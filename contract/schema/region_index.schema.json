{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "region_index.schema.json",
  "title": "regions/index.json",
  "type": "object",
  "required": [
    "schema_version",
    "kind",
    "countries"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "pattern": "^1\\.\\d+$"
    },
    "kind": {
      "const": "region_index"
    },
    "countries": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "bbox",
          "admin1"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Z0-9]{3}$"
          },
          "name": {
            "type": "object",
            "required": [
              "en",
              "tr"
            ],
            "properties": {
              "en": {
                "type": "string",
                "minLength": 1
              },
              "tr": {
                "type": "string",
                "minLength": 1
              }
            },
            "additionalProperties": false
          },
          "bbox": {
            "type": "array",
            "items": {
              "type": "number"
            },
            "minItems": 4,
            "maxItems": 4
          },
          "admin1": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "id",
                "name"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1
                },
                "name": {
                  "type": "object",
                  "required": [
                    "en",
                    "tr"
                  ],
                  "properties": {
                    "en": {
                      "type": "string",
                      "minLength": 1
                    },
                    "tr": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "additionalProperties": false
                },
                "cells": {
                  "type": "number",
                  "minimum": 0
                },
                "low_resolution": {
                  "type": "boolean"
                }
              }
            }
          },
          "continent": {
            "enum": [
              "AF",
              "AN",
              "AS",
              "EU",
              "NA",
              "OC",
              "SA",
              null
            ]
          },
          "cells": {
            "type": "number",
            "minimum": 0
          }
        }
      }
    },
    "continents": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "bbox"
        ],
        "properties": {
          "id": {
            "enum": [
              "AF",
              "AN",
              "AS",
              "EU",
              "NA",
              "OC",
              "SA"
            ]
          },
          "name": {
            "type": "object",
            "required": [
              "en",
              "tr"
            ],
            "properties": {
              "en": {
                "type": "string",
                "minLength": 1
              },
              "tr": {
                "type": "string",
                "minLength": 1
              }
            },
            "additionalProperties": false
          },
          "bbox": {
            "type": "array",
            "items": {
              "type": "number"
            },
            "minItems": 4,
            "maxItems": 4
          },
          "cells": {
            "type": "number",
            "minimum": 0
          }
        }
      }
    }
  }
}