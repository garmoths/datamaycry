{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "region_header.schema.json",
  "title": "regions/{COUNTRY}.bin header",
  "type": "object",
  "required": [
    "schema_version",
    "kind",
    "country",
    "start",
    "months",
    "regions",
    "vars",
    "packing"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "pattern": "^1\\.\\d+$"
    },
    "kind": {
      "const": "region"
    },
    "country": {
      "type": "string",
      "pattern": "^([A-Z0-9]{3}|continents)$"
    },
    "start": {
      "type": "string",
      "pattern": "^\\d{4}-(0[1-9]|1[0-2])$"
    },
    "months": {
      "type": "integer",
      "minimum": 1
    },
    "regions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "level"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "level": {
            "enum": [
              "country",
              "admin1",
              "continent"
            ]
          }
        }
      }
    },
    "vars": {
      "type": "array",
      "minItems": 1,
      "items": {
        "enum": [
          "T2M",
          "QV2M",
          "SPEED",
          "PRECTOT",
          "EVAP",
          "GWETROOT",
          "RUNOFF",
          "SNOMAS",
          "TOTEXTTAU"
        ]
      }
    },
    "packing": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "scale",
          "offset"
        ],
        "properties": {
          "scale": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "offset": {
            "type": "number"
          }
        },
        "additionalProperties": false
      }
    }
  }
}