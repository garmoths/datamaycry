{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "variables.schema.json",
  "title": "variables.json",
  "type": "object",
  "required": [
    "schema_version",
    "kind",
    "dataset",
    "processed_at",
    "is_mock",
    "grid",
    "period",
    "test_years",
    "baseline_years",
    "variables"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "pattern": "^1\\.\\d+$"
    },
    "kind": {
      "const": "variables"
    },
    "dataset": {
      "type": "string"
    },
    "processed_at": {
      "type": "string"
    },
    "is_mock": {
      "type": "boolean"
    },
    "grid": {
      "type": "object",
      "required": [
        "nlat",
        "nlon",
        "lat0",
        "lon0",
        "dlat",
        "dlon"
      ],
      "properties": {
        "nlat": {
          "const": 361
        },
        "nlon": {
          "const": 576
        },
        "lat0": {
          "const": -90
        },
        "lon0": {
          "const": -180
        },
        "dlat": {
          "const": 0.5
        },
        "dlon": {
          "const": 0.625
        }
      },
      "additionalProperties": false
    },
    "period": {
      "type": "object",
      "required": [
        "start",
        "end",
        "months"
      ],
      "properties": {
        "start": {
          "type": "string",
          "pattern": "^\\d{4}-(0[1-9]|1[0-2])$"
        },
        "end": {
          "type": "string",
          "pattern": "^\\d{4}-(0[1-9]|1[0-2])$"
        },
        "months": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "test_years": {
      "type": "object",
      "required": [
        "start",
        "end"
      ],
      "properties": {
        "start": {
          "type": "integer"
        },
        "end": {
          "type": "integer"
        }
      }
    },
    "baseline_years": {
      "type": "object",
      "required": [
        "start",
        "end"
      ],
      "properties": {
        "start": {
          "const": 1991
        },
        "end": {
          "const": 2020
        }
      }
    },
    "variables": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "collection",
          "name",
          "description",
          "unit",
          "unit_raw",
          "convert",
          "packing",
          "decimals",
          "land_only"
        ],
        "properties": {
          "id": {
            "enum": [
              "T2M",
              "QV2M",
              "SPEED",
              "PRECTOT",
              "EVAP",
              "GWETROOT",
              "RUNOFF",
              "SNOMAS",
              "TOTEXTTAU"
            ]
          },
          "collection": {
            "type": "string"
          },
          "name": {
            "type": "object",
            "required": [
              "en",
              "tr"
            ],
            "properties": {
              "en": {
                "type": "string",
                "minLength": 1
              },
              "tr": {
                "type": "string",
                "minLength": 1
              }
            },
            "additionalProperties": false
          },
          "description": {
            "type": "object",
            "required": [
              "en",
              "tr"
            ],
            "properties": {
              "en": {
                "type": "string",
                "minLength": 1
              },
              "tr": {
                "type": "string",
                "minLength": 1
              }
            },
            "additionalProperties": false
          },
          "unit": {
            "type": "string"
          },
          "unit_raw": {
            "type": "string"
          },
          "convert": {
            "type": "object",
            "required": [
              "mul",
              "add"
            ],
            "properties": {
              "mul": {
                "type": "number"
              },
              "add": {
                "type": "number"
              }
            }
          },
          "packing": {
            "type": "object",
            "required": [
              "scale",
              "offset"
            ],
            "properties": {
              "scale": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "offset": {
                "type": "number"
              }
            },
            "additionalProperties": false
          },
          "decimals": {
            "type": "integer",
            "minimum": 0
          },
          "land_only": {
            "type": "boolean"
          },
          "caveat": {
            "type": "object",
            "required": [
              "en",
              "tr"
            ],
            "properties": {
              "en": {
                "type": "string",
                "minLength": 1
              },
              "tr": {
                "type": "string",
                "minLength": 1
              }
            },
            "additionalProperties": false
          },
          "experimental": {
            "type": "boolean"
          },
          "source_field": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}