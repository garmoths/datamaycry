{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "web-mock",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "web",
        "run",
        "dev",
        "--",
        "--port",
        "5173",
        "--strictPort"
      ],
      "port": 5173
    },
    {
      "name": "web-real-local",
      "runtimeExecutable": "sh",
      "runtimeArgs": [
        "-c",
        "cd web && VITE_DATA_URL=/pkg/ npx vite --port 5174 --strictPort"
      ],
      "port": 5174
    },
    {
      "name": "presentation",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "presentation",
        "run",
        "dev",
        "--",
        "--strictPort"
      ],
      "port": 5180
    }
  ]
}