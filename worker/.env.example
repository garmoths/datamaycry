# Copy to worker/.env and fill in. worker/.env is gitignored and must never be committed.
# Cloudflare dashboard → R2 → Manage R2 API Tokens → Create API token
#   Permissions: Object Read & Write (+ Admin Read & Write if upload.py should set CORS)
#   Scope: only the data-may-cry bucket
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=data-may-cry
